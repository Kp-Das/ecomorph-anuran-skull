--------------------------------------------------
 # 1. Prepare the 7-category microhabitat groups
# --------------------------------------------------
group_7 <- factor(
  classifier$microhabitat_broad,
  levels = c(
    "Aquatic",
    "Arboreal",
    "Fossorial",
    "Semi aquatic",
    "Semi arboreal",
    "Semi fossorial",
    "Terrestrial"
  )
)

table(group_7)
scores_t <- as.data.frame(PCA.w.phylo$x)
#matching
identical(
  rownames(scores_t),
  classifier$Species
)
scores_t <- scores_t[
  match(classifier$Species, rownames(scores_t)),
  ,
  drop = FALSE
]
identical(
  rownames(scores_t),
  classifier$Species
)
cva_data <- scores_t[, 1:25]

cva_res_7 <- CVA(
  data = cva_data,
  groups = group_7,
  cv = TRUE
)

summary(cva_res_7)

cva_df_7 <- as.data.frame(cva_res_7$CVscores[, 1:2])

colnames(cva_df_7) <- c("CV1", "CV2")

cva_df_7$Species <- rownames(cva_df_7)

cva_df_7$microhabitat <- group_7
library(ggplot2)
library(dplyr)

habitat_colors_7 <- c(
  "Aquatic"        = "#56B4E9",
  "Semi aquatic"   = "#a87ce2",
  "Terrestrial"    = "#E69F00",
  "Fossorial"      = "#B22222",
  "Semi arboreal"  = "#455b3c",
  "Arboreal"       = "#6B8E23",
  "Semi fossorial" = "#d07a7a"
)

hulls_7 <- cva_df_7 %>%
  group_by(microhabitat) %>%
  filter(n() >= 3) %>%
  slice(chull(CV1, CV2))

p_CVA_7 <- ggplot(cva_df_7, aes(CV1, CV2)) +
  
  geom_polygon(
    data = hulls_7,
    aes(
      fill = microhabitat,
      group = microhabitat
    ),
    alpha = 0.12,
    colour = NA
  ) +
  
  geom_point(
    aes(colour = microhabitat),
    size = 2.8,
    alpha = 0.9
  ) +
  
  scale_colour_manual(values = habitat_colors_7) +
  scale_fill_manual(values = habitat_colors_7) +
  
  labs(
    x = "CV1",
    y = "CV2",
    colour = "Microhabitat",
    fill = "Microhabitat"
  ) +
  
  mytheme_gray

