#============================================================
#Plotting Phylogenetic tree 
# 1. Setup: colors and species-level microhabitat matching


habitat_colors_7 <- c(
  "Aquatic"        = "#56B4E9",
  "Semi aquatic"   = "#a87ce2",
  "Terrestrial"    = "#E69F00",
  "Fossorial"      = "#B22222",
  "Semi arboreal"  = "#455b3c",
  "Arboreal"       = "#6B8E23",
  "Semi fossorial" = "#d07a7a"
)

# Confirm alignment before doing anything else
identical(mytree_p$tip.label, classifier$Species)   # should be TRUE

# Match tip colors to tree order
tip_habitat <- classifier$microhabitat_broad[
  match(mytree_p$tip.label, classifier$Species)
]
tip_colors <- habitat_colors_7[tip_habitat]

sum(is.na(tip_colors))   # should be 0 - confirm no unmatched labels


# 2. Check family monophyly before building sparse labels


tip_data <- data.frame(
  label = mytree_p$tip.label,
  tip_index = 1:length(mytree_p$tip.label)
)
tip_data$Family <- classifier$Family[
  match(tip_data$label, classifier$Species)
]

fam_counts <- table(tip_data$Family)
multi_tip_families <- names(fam_counts[fam_counts >= 2])

is_monophyletic_fam <- sapply(multi_tip_families, function(fam) {
  fam_tips <- tip_data$label[tip_data$Family == fam]
  is.monophyletic(mytree_p, fam_tips)
})

non_monophyletic_families <- names(is_monophyletic_fam[is_monophyletic_fam == FALSE])
print(non_monophyletic_families)   # review before trusting their labels


# 3. Build sparse family label vector
#    (family name placed only at the middle tip of its block)


tip_labels <- rep("", length(mytree_p$tip.label))

for (fam in unique(tip_data$Family)) {
  fam_rows <- tip_data[tip_data$Family == fam, ]
  mid_row <- fam_rows[ceiling(nrow(fam_rows) / 2), ]
  tip_labels[mid_row$tip_index] <- fam
}


# 4. Create a labeled COPY of the tree 


tree_for_plot <- mytree_p
tree_for_plot$tip.label <- tip_labels


# 5. Plot: fan tree, colored tip points, family labels


pdf("phylogeny_family_labels_simple.pdf", width = 25, height = 25)

plot(tree_for_plot,
     type = "fan",
     show.tip.label = TRUE,
     no.margin = TRUE,
     edge.width = 0.8,
     cex = 0.6,
     label.offset = 2,
     align.tip.label = FALSE)

tiplabels(pch = 16, col = tip_colors, cex = 0.8)

legend("bottomleft",
       legend = names(habitat_colors_7),
       col = habitat_colors_7,
       pch = 16,
       cex = 0.9,
       bty = "n")

dev.off()

cat("Saved to phylogeny_family_labels_simple.pdf\n")



