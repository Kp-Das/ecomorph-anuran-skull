classifier <- read.csv("classifier_7cat_micro.csv",header = TRUE)
Portik_tree <- read.tree("Supplementary_File_S3_time_tree.tre")
mydata<-readland.nts("shape_data.txt")
#pruning the tree
tmp <- name.check(Portik_tree, two.d.array(mydata))
mytree_p <- drop.tip(Portik_tree, tip=tmp$tree_not_data)
#my background theme
mytheme_gray <- theme(
  axis.line = element_line(linewidth = 0.5, colour = "black"),
  panel.grid.minor = element_blank(),
  panel.grid.major = element_blank(),
  panel.background = element_rect(fill = "#262626"),
  plot.background = element_rect(fill = "#262626", colour = NA),
  axis.text = element_text(colour = "white", size = 12),
  axis.title = element_text(colour = "white", face = "bold", size = 14),
  legend.background = element_rect(fill = "#262626"),
  legend.key = element_rect(fill = "#262626"),
  legend.text = element_text(colour = "white"),
  legend.title = element_text(colour = "white", face = "bold"),
  plot.title = element_text(colour = "white", face = "bold", hjust = 0.5)
)
#microhabitat colours
habitat_colors_7 <- c(
  "Aquatic"             = "#56B4E9",
  "Semi aquatic"  = "#a87ce2",
  "Terrestrial"         = "#E69F00",
  "Fossorial"           = "#B22222",
  "Semi arboreal"       = "#455b3c",
  "Arboreal"            = "#6B8E23",
  "Semi fossorial"      = "#d07a7a"
)

# PCA coordinates
pca_coords <- PCA$x[, c("Comp1", "Comp2")]

# Match species between PCA and phylogeny
common <- intersect(mytree_p$tip.label, rownames(pca_coords))

tree <- drop.tip(
  mytree_p,
  setdiff(mytree_p$tip.label, common)
)

pca_coords <- pca_coords[tree$tip.label, ]


# Calculate phylogenetic coordinates
pdf(NULL)

phytools::phylomorphospace(
  tree,
  pca_coords,
  node.size = 0,
  ftype = "off"
)

pp <- get("last_plot.phylo", envir = .PlotPhyloEnv)

dev.off()


# Phylogenetic branches
edges <- data.frame(
  x = pp$xx[tree$edge[, 1]],
  y = pp$yy[tree$edge[, 1]],
  xend = pp$xx[tree$edge[, 2]],
  yend = pp$yy[tree$edge[, 2]]
)


# Tip coordinates
tip_data <- data.frame(
  Species = tree$tip.label,
  PC1 = pp$xx[1:Ntip(tree)],
  PC2 = pp$yy[1:Ntip(tree)]
)


# Add 7-category microhabitat
tip_data$microhabitat <- classifier$microhabitat_broad[
  match(
    tip_data$Species,
    classifier$Species
  )
]

tip_data$microhabitat <- factor(
  tip_data$microhabitat,
  levels = names(habitat_colors_7)
)


# Plot PC1 vs PC2
p_PC1_PC2 <- ggplot() +
  
  # Phylogenetic branches
  geom_segment(
    data = edges,
    aes(
      x = x,
      y = y,
      xend = xend,
      yend = yend
    ),
    colour = "grey65",
    linewidth = 0.35
  ) +
  
  # Species points
  geom_point(
    data = tip_data,
    aes(
      x = PC1,
      y = PC2,
      fill = microhabitat
    ),
    shape = 21,
    colour = "black",
    size = 3
  ) +
  
  # Seven habitat colours
  scale_fill_manual(
    values = habitat_colors_7,
    drop = FALSE
  ) +
  
  labs(
    x = "PC1 (27.5%)",
    y = "PC2 (12.6%)",
    fill = "Microhabitat"
  ) +
  
  mytheme_gray

p_PC1_PC2
#saving the plot
ggsave(
  "PhyloMorphospace_PC2_PC3_7_micro.png",
  plot = p_PC1_PC2,
  width = 180,
  height = 140,
  units = "mm",
  dpi = 600)

